# Copy to server/.env (or export) — never commit real secrets. In production load these from a secrets manager.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://astro:astro@localhost:5432/astro
JWT_SECRET=change-me-to-a-long-random-string
STORAGE_KEY_HEX=<64 hex chars: openssl rand -hex 32>
PAYMENT_GATEWAY=mockpay
PAYMENT_WEBHOOK_SECRET=change-me
PUBLIC_API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Consultation modes open for booking (DPR: decide early). MVP: chat
ENABLED_MODES=chat
ACCEPT_WINDOW_MIN=5
PAYOUT_HOLD_DAYS=7
MIN_PAYOUT_PAISE=50000
# Development only: return OTP codes in API responses
OTP_DEV_ECHO=true
