{
  "expo": {
    "name": "Astrovedas",
    "slug": "astrovedas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "astrocustomer",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.astrovedas.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.astrovedas.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E8711A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#4B3FB5"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FDF5EC"
        }
      ]
    ],
    "extra": {
      "apiUrl": ""
    },
    "description": "Talk to verified astrologers by chat or call — kundli, predictions and more."
  }
}
